# ============================================================
#  Infosys AI Knowledge Assistant (Enterprise GPT)
#  Copy this file to  .env  and fill in your values.
#  NEVER commit the real .env file.
# ============================================================

# ---- LLM PROVIDER ----------------------------------------------------
# The app uses Google Gemini by default (generous free tier, good quality).
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used to write the final grounded answer.
# Good options: gemini-2.0-flash (fast, cheap) or gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Model used to embed documents & queries for retrieval.
GEMINI_EMBED_MODEL=text-embedding-004

# ---- RETRIEVAL TUNING ------------------------------------------------
# How many document chunks to pull per query.
TOP_K=5

# Minimum similarity (0-1) for a chunk to be treated as a "real" document
# match. Below this, the assistant answers from general knowledge (like
# Google) and clearly labels the answer as not-from-your-documents.
RELEVANCE_THRESHOLD=0.62

# ---- STORAGE ---------------------------------------------------------
# SQLite file that stores documents, chunks, embeddings, feedback & logs.
# On Render/Railway point this at a mounted disk to persist across deploys.
DATABASE_PATH=./data/knowledge.db

# ---- APP -------------------------------------------------------------
# Comma-separated origins allowed to call the API. "*" for demo.
CORS_ORIGINS=*
